# Copy to .env and fill in.

# Long random string. Generate with: openssl rand -hex 32
SESSION_SECRET=

POSTGRES_PASSWORD=change-me

# Keep true for the review deployment (role switcher, early outcome recording).
DEMO_MODE=true

# Set to true once the site is served over HTTPS.
COOKIE_SECURE=false

# Host port for docker compose.
APP_PORT=80

# Issued by the author. Leave blank for the evaluation build.
LICENSE_KEY=

# Only for RDS (DATABASE_URL is built by compose otherwise)
# DATABASE_URL=postgres://user:pass@your-rds-endpoint:5432/grit
# DATABASE_SSL=true
